
# APPLICATION CONFIGURATION
APP_NAME=YouTube RAG Chatbot
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=False
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# GEMINI LLM CONFIGURATION
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# HUGGING FACE EMBEDDINGS
HF_EMBEDDING_MODEL=BAAI/bge-m3
HF_EMBEDDING_DEVICE=cpu
HF_EMBEDDING_BATCH_SIZE=8
HF_EMBEDDING_NORMALIZE=True
HF_TOKEN=

# DATABASE CONFIGURATION
DATABASE_URL=sqlite:///./youtube_rag.db
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# QDRANT VECTOR DATABASE
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=youtube_transcripts
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=COSINE

# RAG CONFIGURATION
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_TOP_K=5
SIMILARITY_THRESHOLD=0.25
RAG_MAX_CONTEXT_TOKENS=6000

# YOUTUBE CONFIGURATION
YOUTUBE_LANGUAGE=en
YOUTUBE_TRANSCRIPT_ENABLED=True
YOUTUBE_MAX_VIDEO_DURATION_MINUTES=240

# SESSION AND CHAT CONFIGURATION
SESSION_EXPIRY_HOURS=24
MAX_CHAT_HISTORY_MESSAGES=10
MAX_MESSAGE_LENGTH=5000

# SECURITY CONFIGURATION
APP_API_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:8501
RATE_LIMIT_PER_MINUTE=30

# JWT AUTHENTICATION
JWT_SECRET_KEY=a-random-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LOGGING CONFIGURATION
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# WORKER CONFIGURATION
WORKER_ENABLED=False
WORKER_CONCURRENCY=1
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_DELAY=5

# FRONTEND CONFIGURATION
BACKEND_BASE_URL=http://127.0.0.1:8000
STREAMLIT_SERVER_PORT=8501

# CACHE CONFIGURATION
REDIS_URL=

# MONITORING CONFIGURATION
ENABLE_METRICS=False
ENABLE_REQUEST_LOGGING=True
